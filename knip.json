{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreBinaries": ["grype"],
  "workspaces": {
    ".": {
      "entry": ["stylelint.config.mjs"],
      "project": ["**/*.{js,cjs,mjs,ts,cts,mts}", "!packages/**", "!.trunk/**", "!node_modules/**"]
    },
    "packages/common": {
      "entry": "package.json",
      "project": ["src/**/*.ts"]
    },
    "packages/maintenance-factory": {
      "entry": "package.json",
      "project": ["src/**/*.ts"]
    }
  }
}
