# GitHub App credentials
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=                   # PEM key (newlines as \n) or base64-encoded
GITHUB_WEBHOOK_SECRET=
GITHUB_ORG=                           # GitHub organization slug

# GitHub Projects v2
GITHUB_PROJECT_ID=                    # GraphQL node ID (PVT_kwDO...)

# PostgreSQL database
DATABASE_URL=postgres://user:password@localhost:5432/maintenance_factory

# Cursor Background Agent
CURSOR_API_KEY=
CURSOR_API_BASE_URL=https://api.cursor.sh

# Anthropic (Hermes planner)
ANTHROPIC_API_KEY=

# Policy file
POLICY_FILE_PATH=./policy.yaml

# HTTP server
PORT=3000
LOG_LEVEL=info

# Scheduler
SCHEDULER_CRON=0 * * * *             # Hourly
WORKER_BACKEND=cursor                 # cursor | copilot | both
MAX_GLOBAL_CONCURRENT_RUNS=5
MAX_RUNS_PER_REPO=1
MAX_RUNS_PER_TEAM=2
MAX_DAILY_RUNS=30
LOCK_TTL_HOURS=2
SCHEDULER_ENABLED=true
DRY_RUN=false                         # Set to 'true' to log eligible items without launching workers
